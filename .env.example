# ---- Copy to .env and fill in ----

# ElevenLabs API key (free 3-month Creator credit from hacktoberfest.com/my/promos)
# Get it at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# Voice to use for the tutor (free voices: list via GET /v1/voices)
# 21m00Tcm4TlvDq8ikWAM = Rachel (default). Pick a multilingual voice for best results.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# STT/TTS models (defaults are fine)
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ---- Tutor behavior ----

# Language the friend is learning (display name + ISO-639-3 code for STT).
# TARGET_LANGUAGE_CODE is optional: leave empty to auto-detect whatever
# the student speaks (handy when YOU want to test in English).
TARGET_LANGUAGE=Spanish
TARGET_LANGUAGE_CODE=

LEARNER_NAME=my friend
LEARNER_LEVEL=beginner
LEARNER_REASON=conversations with a partner's family
TUTOR_PERSONA=warm, patient, encouraging — like a good friend who happens to be a great teacher

# ---- Local open-weight model (Ollama) ----

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ---- Server ----
PORT=3000